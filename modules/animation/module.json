{
  "name": "animation",
  "version": "1.8.0",
  "description": "Animation systems: Mecanim, Playables, Timeline, LitMotion tweening",
  "required": true,
  "dependencies": {
    "base": ">=1.0.0"
  },
  "skills": [
    "omg-unity-animation-core",
    "omg-unity-animation-litmotion"
  ],
  "agents": [],
  "detect": {
    "files": [
      "**/*.cs"
    ],
    "anyOf": [
      {
        "pattern": "Animator|AnimationClip|PlayableGraph|LitMotion",
        "minHits": 2
      }
    ]
  },
  "source": "upstream-unity"
}
