{
  "$schema": "https://the1studio.github.io/omg/adapter-install.schema.json",
  "contractVersion": "1.0.0",
  "engine": "unity",
  "requires": [
    "mermaid-cli",
    "cs2mermaid"
  ],
  "optionalTools": [
    "graphviz"
  ],
  "prerequisites": [
    {
      "name": ".NET 8 SDK",
      "check": "dotnet --list-sdks",
      "minVersion": "8.0.0",
      "installHintUrl": "https://dotnet.microsoft.com/download/dotnet/8.0"
    }
  ],
  "installSteps": [
    {
      "target": "cs2mermaid",
      "method": "dotnet-tool",
      "handler": "dotnet-tool",
      "package": "Cs2Mermaid",
      "version": "0.6.0",
      "verify": "cs2mmd --version",
      "uninstall": "dotnet tool uninstall -g Cs2Mermaid"
    }
  ],
  "perProject": [],
  "_origin": {
    "kit": "oh-my-game-kit-unity",
    "repository": "The1Studio/oh-my-game-kit-unity",
    "module": "architecture",
    "protected": false
  }
}
